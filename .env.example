# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/asset_lifecycle

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
# RATE_LIMIT_WINDOW_MS=900000   # 15 minutes (default)
# RATE_LIMIT_MAX=100            # max requests per window per IP for general API (default)
# AUTH_RATE_LIMIT_MAX=10        # max login/register attempts per window per IP (default)
